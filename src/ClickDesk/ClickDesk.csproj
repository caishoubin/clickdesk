<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>ClickDesk</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ClickDesk 鼠标录制器</Product>
    <Description>录制鼠标点击，按原有节奏重复执行。</Description>
    <Company>ClickDesk</Company>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClickDesk.Core/ClickDesk.Core.csproj" />
  </ItemGroup>
</Project>
